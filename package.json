{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-bluebubbles",
  "version": "0.1.0",
  "description": "Securely bridge BlueBubbles conversations into isolated OpenCode sessions.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "keywords": [
    "opencode",
    "bluebubbles",
    "imessage"
  ],
  "license": "MIT",
  "dependencies": {
    "@opencode-ai/plugin": "1.18.7",
    "socket.io-client": "4.8.1",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
