{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "plugin": [
    [
      "./src/index.ts",
      {
        "serverUrl": "http://127.0.0.1:1234",
        "passwordEnv": "BLUEBUBBLES_PASSWORD",
        "instanceId": "local-bluebubbles",
        "alias": "opencode",
        "sendMethod": "private-api",
        "remoteAgent": "bluebubbles-remote",
        "model": "openai/gpt-5.4-mini",
        "sessionDirectory": "~/OpenCode/BlueBubbles",
        "pinExpiryMinutes": 15,
        "pinAttempts": 5,
        "permissionExpiryMinutes": 15,
        "maxConcurrentSessions": 4,
        "thinkingReaction": false,
        "typingIndicator": true,
        "toolCallMessages": false,
        "personalityTokens": {
          "silly_humor": {
            "value": 50,
            "description": "Controls dry, playful humor and light banter."
          }
        },
        "permissionWaitMessage": "Hang on, an administrator needs to approve that."
      }
    ]
  ]
}
